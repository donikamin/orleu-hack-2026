{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm ci --prefix app",
  "buildCommand": "npm run build --prefix app",
  "outputDirectory": "app/dist",
  "rewrites": [
    {
      "source": "/api/hint",
      "destination": "/api/check?r=hint"
    },
    {
      "source": "/api/grade",
      "destination": "/api/check?r=grade"
    },
    {
      "source": "/api/why",
      "destination": "/api/check?r=why"
    },
    {
      "source": "/((?!api/|home/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "includeFiles": "content/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 12 * * *"
    }
  ]
}
