# Скопировать в .env.local (он в .gitignore) для локальной разработки.
# На Vercel: Settings → Environment Variables. Без ключей приложение работает на статических подсказках.
# Какой ИИ работает: claude (по умолчанию) или gemini. Переключение — смена этой строки и Redeploy.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Для AI_PROVIDER=gemini: aistudio.google.com → Get API key
GEMINI_API_KEY=
# Необязательно: другая модель для подсказок и проверки (claude-haiku-5-5; для Gemini по умолчанию gemini-3.5-flash-lite) и для фото.
AI_MODEL=
AI_MODEL_PHOTO=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
# Две случайные строки (латиница и цифры, от 20 символов)
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
