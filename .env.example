# Скопировать в .env.local (он в .gitignore) для локальной разработки.
# На Vercel: Settings → Environment Variables. Без ключей приложение работает на статических подсказках.
ANTHROPIC_API_KEY=
# Необязательно: другая модель для подсказок и проверки (например claude-haiku-5-5) и для фото.
AI_MODEL=
AI_MODEL_PHOTO=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
# Две случайные строки (латиница и цифры, от 20 символов)
TELEGRAM_WEBHOOK_SECRET=
CRON_SECRET=
